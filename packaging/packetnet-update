#!/bin/sh
# packetnet-update - the per-channel update DISPATCHER.
#
# This is the ExecStart of packetnet-update.service (the privileged, detached oneshot the
# node triggers via `systemctl start --no-block`, polkit-authorized). apt-vs-github is a
# RUNTIME decision the node makes (dpkg ownership + apt-cache repo origin), so the node
# writes the resolved channel to the spool (/run/packetnet/update.channel) just before
# triggering, and this dispatcher execs the matching helper. That way the SINGLE oneshot
# serves both channels. docs/node-self-update-design.md.
set -eu

TAG=packetnet-update
LIB="${PDN_HELPER_DIR:-/usr/lib/packetnet}"
SPOOL="${PDN_UPDATE_SPOOL:-/run/packetnet}"
CHANNEL_FILE="$SPOOL/update.channel"

log() { logger -t "$TAG" -- "$*" 2>/dev/null || true; echo "$TAG: $*"; }

# The node writes the resolved channel. Without it we cannot tell apt from github, and
# guessing would either run an unwanted apt upgrade or a redundant dpkg install - so refuse.
channel=""
if [ -r "$CHANNEL_FILE" ]; then
    channel="$(head -1 "$CHANNEL_FILE" | tr -d '[:space:]')"
fi
if [ -z "$channel" ]; then
    log "no resolved channel in $CHANNEL_FILE - refusing"; exit 1
fi

log "dispatching update on channel: $channel"
case "$channel" in
    apt)    exec "$LIB/packetnet-apt-update" ;;
    github) exec "$LIB/packetnet-github-update" ;;
    *)      log "unknown channel '$channel' - refusing"; exit 1 ;;
esac
