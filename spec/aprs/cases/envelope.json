{
  "cases": [
    {
      "id": "envelope/digipeated-path",
      "description": "A TNC2 header whose path has been digipeated twice.",
      "source": "UAP 1",
      "authority": "spec",
      "input": {"tnc2": "WB2OSZ>APDW18,N2GH,W2UB*,WIDE2-1:>hello"},
      "expect": {
        "header": {"source": "WB2OSZ", "destination": "APDW18", "path": ["N2GH*", "W2UB*", "WIDE2-1"]},
        "data": {"type": "status", "text": "hello"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "envelope/q-construct",
      "description": "An APRS-IS header with a q-construct naming the IGate.",
      "source": "APRS-IS",
      "authority": "spec",
      "input": {"tnc2": "N0CALL-9>APZ001,WIDE1-1,qAR,M0LTE-10:>hello"},
      "expect": {
        "header": {"source": "N0CALL-9", "destination": "APZ001", "path": ["WIDE1-1", "qAR", "M0LTE-10"], "q_construct": {"construct": "qAR", "station": "M0LTE-10"}},
        "data": {"type": "status", "text": "hello"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "envelope/ax25-frame",
      "description": "The same kind of packet as an AX.25 UI frame (KISS form: no flags, no FCS).",
      "source": "APRS12c ch. 3",
      "authority": "spec",
      "input": {"ax25_hex": "82A0B4606062E09A6098A88A40729A6098A88A40E2AE92888A64406303F03E68656C6C6F"},
      "expect": {
        "header": {"source": "M0LTE-9", "destination": "APZ001", "path": ["M0LTE-1*", "WIDE2-1"]},
        "data": {"type": "status", "text": "hello"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "envelope/no-header",
      "description": "A line with no SOURCE>DEST: header cannot be decoded at all.",
      "source": "UAP 1",
      "authority": "spec",
      "input": {"tnc2": "no header at all"},
      "expect": {
        "header_error": ["error:invalid-header"]
      },
      "strict": "same"
    },
    {
      "id": "envelope/multiple-used-markers",
      "description": "Several path entries marked * : a strict decoder rejects the header, a lenient one takes the last as the last used.",
      "source": "UAP 5.30",
      "authority": "spec",
      "input": {"tnc2": "K2CAT-1>APAT51,K2RVW-1*,WIDE1*,WIDE2-2,qAR,N1ATP-12:!4150.67N/07404.71W-000/000/A=000000HVNY-73"},
      "expect": {
        "header": {"source": "K2CAT-1", "destination": "APAT51", "path": ["K2RVW-1*", "WIDE1*", "WIDE2-2", "qAR", "N1ATP-12"], "q_construct": {"construct": "qAR", "station": "N1ATP-12"}},
        "data": {"type": "position", "latitude": 41.8445, "longitude": -74.0785, "symbol": "/-", "course_degrees": 0, "speed_knots": 0, "altitude_feet": 0, "comment": "HVNY-73"},
        "diagnostics": ["warning:multiple-used-markers"]
      },
      "strict": {"rejected_by": "multiple-used-markers", "header": true},
      "reencode": "identical"
    },
    {
      "id": "envelope/colons-after-the-first-belong-to-the-information-field",
      "description": "Colons after the first belong to the information field.",
      "source": "UAP 1",
      "authority": "spec",
      "input": {"info": ":N0CALL-1 :hi"},
      "expect": {
        "data": {"type": "message", "addressee": "N0CALL-1", "text": "hi"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "envelope/an-unusable-header-throws",
      "description": "An unusable header throws.",
      "source": "UAP 1",
      "authority": "spec",
      "input": {"tnc2": "N0 CALL>APZ001:>hi"},
      "expect": {
        "header_error": ["error:invalid-address"]
      },
      "strict": "same"
    },
    {
      "id": "envelope/an-unusable-header-throws-2",
      "description": "An unusable header throws.",
      "source": "UAP 1",
      "authority": "spec",
      "input": {"tnc2": "N0CALL:>hi"},
      "expect": {
        "header_error": ["error:invalid-header"]
      },
      "strict": "same"
    },
    {
      "id": "envelope/an-unusable-header-throws-3",
      "description": "An unusable header throws.",
      "source": "UAP 1",
      "authority": "spec",
      "input": {"tnc2": ">APZ001:>hi"},
      "expect": {
        "header_error": ["error:invalid-header"]
      },
      "strict": "same"
    },
    {
      "id": "envelope/ax25-rejects-non-ui-frames",
      "description": "Ax25 rejects non ui frames.",
      "source": "APRS12c ch. 3",
      "authority": "spec",
      "input": {"ax25_hex": "82A0B4606062E09C6086829898613FF03E78"},
      "expect": {
        "header_error": ["error:not-aprs-frame"]
      },
      "strict": "same"
    },
    {
      "id": "envelope/tnc2-header-without-path",
      "description": "Tnc2 header without path.",
      "source": "UAP 1",
      "authority": "spec",
      "input": {"info": ">hi"},
      "expect": {
        "data": {"type": "status", "text": "hi"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "envelope/ax25-nul-padding-is-tolerated-by-default-and-rejected-when",
      "description": "Ax25 nul padding is tolerated by default and rejected when strict.",
      "source": "APRS12c ch. 3",
      "authority": "spec",
      "input": {"ax25_hex": "82A082A86A62E096648682A8006303F021343135302E36374E2F30373430342E3731572D"},
      "expect": {
        "header": {"source": "K2CAT-1", "destination": "APAT51"},
        "data": {"type": "position", "latitude": 41.8445, "longitude": -74.0785, "symbol": "/-"},
        "diagnostics": ["warning:nul-padded-address"]
      },
      "strict": {"rejected_by": "nul-padded-address", "header": true},
      "reencode": "identical"
    },
    {
      "id": "envelope/ax25-lower-case-address-is-tolerated-by-default-and",
      "description": "Ax25 lower case address is tolerated by default and rejected when strict.",
      "source": "APRS12c ch. 3",
      "authority": "spec",
      "input": {"ax25_hex": "82A0B4606062E0DC648E9040406103F03E78"},
      "expect": {
        "header": {"source": "n2GH", "destination": "APZ001"},
        "data": {"type": "status", "text": "x"},
        "diagnostics": ["warning:invalid-ax25-address-characters"]
      },
      "strict": {"rejected_by": "invalid-ax25-address-characters", "header": true},
      "reencode": "identical"
    },
    {
      "id": "envelope/aprs-is-names-need-not-be-ax25",
      "description": "Aprs is names need not be ax25.",
      "source": "UAP 3.8",
      "authority": "spec",
      "input": {"tnc2": "N1KWG-10>APWW11,TCPIP*,qAC,T2SPAIN:=4301.96N/07123.43Wr"},
      "expect": {
        "header": {"source": "N1KWG-10", "destination": "APWW11", "path": ["TCPIP*", "qAC", "T2SPAIN"], "q_construct": {"construct": "qAC", "station": "T2SPAIN"}},
        "data": {"type": "position", "messaging": true, "latitude": 43.032666666666664, "longitude": -71.3905, "symbol": "/r"}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "envelope/non-utf8-bytes-survive-in-the-raw-information-field",
      "description": "Non utf8 bytes survive in the raw information field.",
      "source": "UAP 1",
      "authority": "spec",
      "input": {"tnc2_hex": "46314951483E41505532354E3A3E44583A203637F82032323A3138"},
      "expect": {
        "data": {"type": "status", "text": "DX: 67ø 22:18"},
        "diagnostics": ["warning:non-utf8-text"]
      },
      "strict": {"rejected_by": "non-utf8-text"},
      "reencode": "equivalent",
      "canonical_info": ">DX: 67ø 22:18"
    },
    {
      "id": "envelope/ax25-frame-round-trip",
      "description": "Ax25 frame round trip.",
      "source": "APRS12c ch. 3",
      "authority": "spec",
      "input": {"ax25_hex": "82A088AE6270E0AE84649EA6B46A9C648E904040E0AE92888A64406303F021343233372E31344E5330373132302E3833572350484737313430"},
      "expect": {
        "header": {"source": "WB2OSZ-5", "destination": "APDW18", "path": ["N2GH*", "WIDE2-1"]},
        "data": {"type": "position", "latitude": 42.619, "longitude": -71.34716666666667, "symbol": "S#", "phg": {"power": 7, "height": 1, "gain": 4, "directivity": 0}}
      },
      "strict": "same",
      "reencode": "identical"
    },
    {
      "id": "envelope/aprs-is-q-construct-and-igate",
      "description": "Aprs is q construct and igate.",
      "source": "UAP 3.8",
      "authority": "spec",
      "input": {"tnc2": "KB1QV-1>4SQP3U,WIDE1-1,WIDE2-1,qAR,N3LLO-2:`cK+l \u001C>/"},
      "expect": {
        "header": {"source": "KB1QV-1", "destination": "4SQP3U", "path": ["WIDE1-1", "WIDE2-1", "qAR", "N3LLO-2"], "q_construct": {"construct": "qAR", "station": "N3LLO-2"}},
        "data": {"type": "mic-e", "mic_e_message": "committed", "latitude": 43.1725, "longitude": -71.78583333333333, "symbol": "/>", "speed_knots": 0}
      },
      "strict": "same",
      "reencode": "identical"
    }
  ]
}
