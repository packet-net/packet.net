    {
      "id": "status-other/user-defined-space-packet-type",
      "description": "APRS12c places no limit on the user ID or packet type, so a space is a packet type like any other and is written back as it came. Seen from a BPQ node's CQBEEP test beacon.",
      "source": "APRS-IS 2026-09-26",
      "authority": "spec",
      "input": {"tnc2": "GB7WEM>CQBEEP-5,qAR,GB7BPQ:{1 !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQR"},
      "expect": {
        "header": {"source": "GB7WEM", "destination": "CQBEEP-5", "path": ["qAR", "GB7BPQ"], "q_construct": {"construct": "qAR", "station": "GB7BPQ"}},
        "data": {"type": "user-defined", "user_id": "1", "packet_type": " ", "data": "!\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQR"}
      },
      "strict": "same",
      "reencode": "identical"
    },
