    {
      "id": "mic-e/spec-worked-example",
      "description": "The spec's worked example: latitude, the Returning message and the +100 longitude offset in the destination; longitude, course, speed and symbol in the information field.",
      "source": "APRS12c ch. 10",
      "authority": "spec",
      "input": {"tnc2": "N0CALL>S32UVT:`(_fn\"Oj/"},
      "expect": {
        "header": {"source": "N0CALL", "destination": "S32UVT"},
        "data": {"type": "mic-e", "mic_e_message": "returning", "latitude": 33.42733333333334, "longitude": -112.129, "symbol": "/j", "course_degrees": 251, "speed_knots": 20}
      },
      "strict": "same",
      "reencode": "identical"
    },
