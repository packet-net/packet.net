    {
      "id": "message/general-query-with-footprint-uses-a-space-for-positive",
      "description": "General query with footprint uses a space for positive.",
      "source": "APRS12c ch. 15",
      "authority": "spec",
      "input": {"info": "?APRS? 34.02,-117.15,0200"},
      "expect": {
        "data": {"type": "query", "query_type": "APRS", "footprint": {"latitude": 34.02, "longitude": -117.15, "radius_miles": 200}}
      },
      "strict": "same",
      "reencode": "identical"
