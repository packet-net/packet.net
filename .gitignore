# Build artifacts
[Bb]in/
[Oo]bj/
[Oo]ut/
[Pp]ublish/
artifacts/
# staged per-arch app trees for the docker build (scripts/docker-image.sh)
pdn-app/
# local build output of the embedded Tailscale sidecar (built/staged by build-deb.sh)
/sidecar/tsnet/packetnet-tsnet
*.user
*.suo
.vs/
.vscode/launch.json

# Test results & coverage
TestResults/
coverage/
*.coverage
*.coveragexml
*.trx

# Generated SDL artifacts (regenerated via tools/Packet.Sdl.CodeGen)
# We DO check generated *.g.cs in (so reviewers can diff against YAML).
# Don't ignore them.

# Tooling caches
.idea/
*.swp
.DS_Store
.claude/

# Stryker reports + scratch
artifacts/
StrykerOutput/

# Local node state (used when running the node out of the repo)
.local/
node-data/
*.db
*.db-shm
*.db-wal

# Frontend
# Generic, deliberately: web/ax25/node_modules stayed tracked for months (3058 files, 19 MB)
# after the library moved to packet-net/ax25-ts, because the only rules were per-directory
# (packet.net#699 / C102). ci.yml's `guards` job fails if anything under node_modules/ is
# tracked again.
node_modules/
web/*/dist/
web/packetnet-ui/.vite/
web/packetnet-ui/.turbo/
web/packetnet-ui/pnpm-lock.yaml.bak

# Docker
docker/.build-cache/

# LinBPQ runtime artifacts (extracted by the container at startup, not source)
docker/linbpq/HTML/
docker/linbpq/BPQNODES.dat
docker/linbpq/MHSave.txt
docker/linbpq/logs/
docker/linbpq/*.log

# Secrets — never commit
*.pem
!installers/sigstore-pubkey.pem
*.pfx
appsettings.Local.json
appsettings.*.user.json

# Per-developer launch configuration (port choices, env vars)
**/Properties/launchSettings.json

# OS
Thumbs.db
ehthumbs.db

# Generated: the web UI build copied in for the host to serve
src/Packet.Node/wwwroot/
