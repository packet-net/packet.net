<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Persistence -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Dapper" Version="2.1.79" />

    <!-- Auth -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Fido2.AspNet" Version="4.0.1" />
    <!-- Fido2 pulls Microsoft.Bcl.Memory transitively, and the 9.x it asks for carries
         CVE-2026-26127 (GHSA-73j8-2gch-69rq — OOB read decoding malformed Base64Url).
         Pin the first patched 9.x (9.0.14) via CPM transitive pinning so the restore
         resolves the fixed build and warnings-as-errors (NU1903) stays clean. Still
         load-bearing on Fido2.AspNet 4.0.1 — verified in the restored graph. -->
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="9.0.14" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageVersion Include="Microsoft.IdentityModel.Tokens" Version="8.22.0" />
    <!-- JWT bearer validation middleware for the host (the node auth foundation, ON by
         default since the LAN-bind flip — management.auth.enabled). 10.0.10 is the current
         .NET 10 servicing build; it depends on Microsoft.IdentityModel.* 8.x, aligned with
         the JsonWebTokens/Tokens pins above. -->
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <!-- YARP's direct-forwarding primitive (IHttpForwarder) backs the app-gateway reverse
         proxy (/apps/{id}/* → an app's loopback web server). Used standalone (no config-driven
         proxy model) — just correct streaming/header/WebSocket forwarding. See docs/app-gateway.md. -->
    <PackageVersion Include="Yarp.ReverseProxy" Version="2.3.0" />

    <!-- Logging / telemetry (opt-in only) -->
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="OpenTelemetry" Version="1.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.10.0" />

    <!-- HTTP + validation -->
    <PackageVersion Include="Refit" Version="8.0.0" />
    <PackageVersion Include="FluentValidation" Version="11.11.0" />
    <PackageVersion Include="FluentValidation.AspNetCore" Version="11.3.0" />

    <!-- Node host config — the YAML config blob (Phase 4 slice 1). The file is
         the blob today; a later slice stores the same YAML in a SQLite column
         behind the IConfigProvider seam, so nothing couples to the format. -->
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />

    <!-- Generic Host abstractions for Packet.Node.Core (BackgroundService,
         IHostApplicationLifetime, ILogger). The host shell (Packet.Node) pulls
         the full hosting stack via Microsoft.NET.Sdk.Web; the core library
         depends only on the abstractions. -->
    <!-- Floor, not preference: the MCP SDK (Phase 8) requires Logging.Abstractions >= 10.0.7
         (Core) and Hosting.Abstractions >= 10.0.7 (.AspNetCore), and CPM transitive pinning
         turns anything lower into an NU1109 downgrade error. 10.0.10 is the current .NET 10
         servicing build, above that floor and back-compatible for every other consumer. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />

    <!-- Soundmodem (GPL-3.0-or-later sibling repo packet-net/pdn-soundmodem; AGPL node
         combines with it under GPLv3 §13 / AGPLv3 §13) -->
    <PackageVersion Include="pdn-soundmodem" Version="0.6.0" />
    <!-- POCSAG paging codec (arrives transitively via pdn-soundmodem; referenced explicitly for
         the PagingHostedService's PocsagPolarity). -->
    <PackageVersion Include="M0LTE.Pocsag" Version="0.1.0" />
    <!-- ARDOP virtual TNC engine (arrives transitively via pdn-soundmodem; referenced explicitly
         for the ArdopHostedService's ArdopHostTnc/ArdopHostServer). -->
    <PackageVersion Include="M0LTE.Ardop" Version="0.1.0" />

    <!-- Serial / IO -->
    <PackageVersion Include="System.IO.Ports" Version="10.0.10" />

    <!-- MQTT (SP-001 spike — LinBPQ feed ingestion; the node's kissproxy-compatible
         frame emitter uses the ManagedClient extension for auto-reconnect). -->
    <PackageVersion Include="MQTTnet" Version="4.3.7.1207" />
    <PackageVersion Include="MQTTnet.Extensions.ManagedClient" Version="4.3.7.1207" />

    <!-- mDNS / DNS-SD browsing (split-station Stage 3b — head-end discovery). Zeroconf is a
         cross-platform, Linux-working resolver that binds :5353 with address-reuse so it coexists
         with the avahi-daemon the node's own advertiser (avahi-publish) registers through. Used
         only behind the thin IHeadEndDiscovery seam (MdnsHeadEndDiscovery); tests use a fake. -->
    <PackageVersion Include="Zeroconf" Version="3.7.16" />

    <!-- CommandLineParser — used by the Packet.Term TUI's CLI. (NB: Packet.Term
         itself moves to packet-net/packet-term-tui in a sibling PR; once that lands
         this can be dropped.) -->
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />

    <!-- AX.25 SDL state machines — consumed from packet-net/ax25sdl as a NuGet
         package. Source repo: github.com/packet-net/ax25sdl.
         HELD at 0.10.0: 0.10.2 regenerates the timer_recovery tables off the upstream
         figc4.5 SREJ correction (ax25sdl#78 / packethacking/ax25spec#65), which makes the
         SREJ *command* paths do an actionable single-frame retransmit where the buggy
         figure's go-back-N was a no-op under our selective-SREJ quirk. That flips
         DataLinkSrejUnderLossTests.Srej_command_does_not_retransmit_under_default, which
         pins §4.3.2.4's "SREJ is only sent as a response" reading (direwolf and linbpq both
         ignore an SREJ command). Spec-vs-de-facto call to make before bumping — see #674. -->
    <PackageVersion Include="Packet.Ax25.Sdl" Version="0.10.0" />

    <!-- MCP — the official C# SDK (Anthropic + .NET). Packet.Mcp (the
         transport-agnostic tool surface) takes .Core; the node host takes
         .AspNetCore to mount the Streamable-HTTP transport in its pipeline.
         Phase 8 / docs/mcp-design.md. -->
    <PackageVersion Include="ModelContextProtocol.Core" Version="1.4.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.3.4" />
    <PackageVersion Include="Testcontainers" Version="4.13.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="AwesomeAssertions" Version="9.5.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.61" />

    <!-- Fuzzing (SP-004 — AX.25 / KISS wire-format fuzzer) -->
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />

    <!-- Build housekeeping -->
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

</Project>
